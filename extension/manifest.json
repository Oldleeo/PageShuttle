{
  "manifest_version": 3,
  "name": "页梭",
  "short_name": "页梭",
  "description": "页梭·Chrome 专属代理，支持常用节点导入、环境跟随、搜索和收藏。",
  "version": "0.6.1",
  "homepage_url": "https://x.com/oldleeoo",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "proxy",
    "storage",
    "nativeMessaging",
    "webRequest",
    "webRequestAuthProvider",
    "privacy",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["location-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["location-bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "页梭·Chrome 专属代理",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
